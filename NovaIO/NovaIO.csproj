<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Nova.IO for mass spectrometry data input and output.</Title>
    <Authors>Michael Hoopmann, Devin Schweppe</Authors>
    <Company>University of Washington, Schweppe Lab</Company>
    <PackageId>Nova.IO</PackageId>
    <Description>Mass spectrometry data input and output.</Description>
    <Copyright>Copyright 2025</Copyright>
    <PackageProjectUrl>https://github.com/SchweppeLab/Nova</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SchweppeLab/Nova</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mass spectrometry;spectrum</PackageTags>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;8600;8602</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <NoWarn>1701;1702;8600;8602</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;8600;8602</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <NoWarn>1701;1702;8600;8602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Exact-match brackets, not a bare version number: a bare version string is a NuGet
         *minimum* bound ([X,)), not a pin. That's exactly how CI silently drifted from 8.0.6
         onto 8.0.37 originally (see docs/known-issues.md CI-1/BUG-7); 8.0.37 is now the
         deliberate, tested target (bumped 2026-08-19, after fixing HYG-1: 8.0.37 dropped the
         Microsoft.AspNetCore.Mvc.NewtonsoftJson dependency this package's stray unused usings
         had been quietly relying on to compile). Keep these brackets when bumping again. -->
    <PackageReference Include="ThermoFisher.CommonCore.Data" Version="[8.0.37]" />
    <PackageReference Include="ThermoFisher.CommonCore.RawFileReader" Version="[8.0.37]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nova\Nova.csproj" />
  </ItemGroup>

</Project>
