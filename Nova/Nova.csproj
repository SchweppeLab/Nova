<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Nova</RootNamespace>
    <AssemblyName>Nova</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Deterministic>true</Deterministic>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Nova core library for mass spectrometry data management.</Title>
    <Authors>Michael Hoopmann, Devin Schweppe</Authors>
    <Company>University of Washington, Schweppe Lab</Company>
    <PackageId>Nova</PackageId>
    <Description>Mass spectrometry spectral data model and interprocess communication (named pipes).</Description>
    <Copyright>Copyright 2025-2026</Copyright>
    <PackageProjectUrl>https://github.com/SchweppeLab/Nova</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SchweppeLab/Nova</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mass spectrometry;spectrum</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
1.1.1 - in development; no changes yet.

CORRECTIONS TO THE 1.1.0 NOTES
* ScanDescription was listed as new. It has been on SpectrumFoundation since
  1.0.0.18. What changed in 1.1.0 is that pipe serialization includes it.

https://github.com/SchweppeLab/Nova
    </PackageReleaseNotes>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
