{
  // This project deliberately installs no VS Code extensions. See
  // docs/CONTENT_GUIDE.md. Verification runs through a local Jekyll build,
  // not through the editor.
  //
  // The formatter, Liquid, stylelint and macOS terminal settings that used to
  // live here all pointed at extensions that are not installed, so they did
  // nothing except silently disable the editor's own built-in CSS and SCSS
  // validation. They were removed rather than left as dead configuration.
}
