<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NovaSnippets exists so that every code example published on the Nova
    website is compiled before it is published. A snippet that does not build
    here does not go on the site.

    This is not a test project. The snippets are written the way a user writes
    code against Nova in their own project, which is also why Nova is restored
    from the release nupkg rather than from a project reference.

    See README.md in this folder for the restore step.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Snippets are illustrative, so unused variables and unawaited calls are
         expected and must not fail the build. Real errors still do. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS1998</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to exact versions so the snippets are always compiled against the
         release being documented, never against whatever else is lying around. -->
    <PackageReference Include="Nova" Version="[1.1.0]" />
    <PackageReference Include="Nova.IO" Version="[1.1.0]" />
  </ItemGroup>

</Project>
