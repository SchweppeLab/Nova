<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Nova is not published to nuget.org. It ships as nupkg files inside the
    release zip, so this project restores it from the local packages folder.

    clear is important. There is an unrelated package called "Nova" on
    nuget.org, at versions 1.0.0 and 1.0.1, belonging to someone else. Without
    clearing inherited sources, a restore can pull that one instead.
    nuget.org is re-added below because SharpZipLib comes from there.
  -->
  <packageSources>
    <clear />
    <add key="nova-local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Belt and braces: Nova and Nova.IO may only ever come from the local folder,
    never from nuget.org, whatever a version range would otherwise allow.
  -->
  <packageSourceMapping>
    <packageSource key="nova-local">
      <package pattern="Nova" />
      <package pattern="Nova.IO" />
      <package pattern="ThermoFisher.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
